# LLM provider: "groq" (recommended, free), "gemini", "openai", or "none" (template fallback)
LLM_PROVIDER=none

# Groq API Key (recommended — free at https://console.groq.com)
GROQ_API_KEY=

# Gemini API Key (free at https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# OpenAI API Key (paid)
OPENAI_API_KEY=
